msgid "Do not assign title from rule"
msgstr "Ne rendeljen címet a szabályból"

#: paperless_mail/models.py:138
msgid "Do not assign a correspondent"
msgstr "Ne rendeljen hozzá partnert"

#: paperless_mail/models.py:139
